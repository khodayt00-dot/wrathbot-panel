<script>
(function() {
    // ========== ناوبری ==========
    function showPage(n) {
        for (let i = 1; i <= 5; i++) {
            const page = document.getElementById('p' + i);
            const btn = document.getElementById('b' + i);
            if (page) page.classList.remove('show');
            if (btn) btn.classList.remove('active');
        }
        const targetPage = document.getElementById('p' + n);
        const targetBtn = document.getElementById('b' + n);
        if (targetPage) targetPage.classList.add('show');
        if (targetBtn) targetBtn.classList.add('active');
        window.scrollTo(0, 0);
        if (n === 4) setTimeout(initMemory, 100);
    }

    // وصل کردن دکمه‌های پایین
    document.querySelectorAll('.nav button').forEach(btn => {
        btn.addEventListener('click', function() {
            const pageNum = parseInt(this.getAttribute('data-page'));
            showPage(pageNum);
        });
    });

    // ========== قیمت ==========
    const PRICE = 4000;
    const slider = document.getElementById('daysSlider');
    const daysNum = document.getElementById('daysNum');
    const priceAmount = document.getElementById('priceAmount');

    function formatNum(n) {
        return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, "،");
    }

    function updatePrice() {
        const days = parseInt(slider.value) || 7;
        daysNum.textContent = days;
        priceAmount.textContent = formatNum(days * PRICE);
        document.querySelectorAll('.quick-days button').forEach(b => {
            b.classList.toggle('active', parseInt(b.getAttribute('data-days')) === days);
        });
    }

    slider.addEventListener('input', updatePrice);

    document.querySelectorAll('.quick-days button').forEach(btn => {
        btn.addEventListener('click', function() {
            const d = parseInt(this.getAttribute('data-days'));
            slider.value = d;
            updatePrice();
        });
    });

    updatePrice();

    // ========== بازی واکنش ==========
    let rState = 'ready';
    let rStart = 0;
    let rTimer = null;
    const box = document.getElementById('box');
    const result = document.getElementById('result');

    box.addEventListener('click', function() {
        if (rState === 'ready') {
            rState = 'waiting';
            box.className = '';
            box.style.background = '#111';
            box.style.borderColor = '#555';
            box.textContent = 'صبر کن...';
            result.textContent = '';
            const delay = 1400 + Math.random() * 2600;
            rTimer = setTimeout(() => {
                rState = 'go';
                box.className = 'go';
                box.textContent = 'الان بزن!';
                rStart = performance.now();
            }, delay);
        } else if (rState === 'waiting') {
            clearTimeout(rTimer);
            rState = 'ready';
            box.className = 'fail';
            box.textContent = 'خیلی زود زدی!';
            result.textContent = 'دوباره امتحان کن';
            setTimeout(() => {
                box.className = 'ready';
                box.textContent = 'برای شروع ضربه بزن';
                result.textContent = '';
            }, 1400);
        } else if (rState === 'go') {
            const t = Math.round(performance.now() - rStart);
            rState = 'ready';
